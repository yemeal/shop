# ===================================================================
# Конфигурация развертывания интернет-магазина (Docker Compose)
# Скопируйте этот файл в .env перед запуском: cp .env.example .env
# ===================================================================

# Порты хост-системы
FRONTEND_PORT=80
BACKEND_PORT=3000

# Режим окружения Node.js
NODE_ENV=production

# Безопасность cookie:
# Выставите в true, если сайт открывается по защищенному протоколу HTTPS (с SSL-сертификатом).
# Оставьте false, если обращаетесь к серверу напрямую по обычному HTTP (например, http://<IP-сервера>).
COOKIE_SECURE=false

# Разрешенные источники для CORS (через запятую).
# Если развертывание идет на своем домене или внешнем IP, укажите их здесь (например: http://192.168.1.100,https://shop.example.com).
# Для разрешения всех источников можно указать: ALLOWED_ORIGINS=*
ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:3000,http://localhost:5173,http://127.0.0.1,http://127.0.0.1:80,http://127.0.0.1:3000,http://127.0.0.1:5173

# Внутренние пути (внутри контейнера бэкенда, не требуют изменения)
DB_FILE=/app/data/shop.db
KEYS_DIR=/app/data/keys

# Настройки времени жизни JWT токенов
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_MS=2592000000
